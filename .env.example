# Copy this file to .env.local and fill in what you have.
# With nothing filled in, the site runs in "preview mode" (sample data, pretend sign-in).

# Your site's public address (used in sign-in emails, QR codes and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin page password (/admin). Pick a long one.
ADMIN_PASSWORD=
# Optional: any long random string; changing it signs everyone out of admin
ADMIN_SESSION_SECRET=

# Claude API key for turning messy pages into listings (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: which Claude model does extraction (default claude-opus-5-5)
# EXTRACTION_MODEL=claude-opus-5-5

# Where the daily "sources needing attention" digest goes, and the contact
# email the collector shows to websites in its user-agent
ADMIN_EMAIL=
CONTACT_EMAIL=

# Optional: send the digest with Resend (resend.com). Without it, it's just logged.
RESEND_API_KEY=
EMAIL_FROM=Little SF <hello@yourdomain.com>

# Vercel Cron sends this as a password to /api/cron/*. Any long random string.
CRON_SECRET=

# Optional sources
EVENTBRITE_TOKEN=
# CHROMIUM_PATH=/path/to/chrome   # only if Playwright can't find a browser
